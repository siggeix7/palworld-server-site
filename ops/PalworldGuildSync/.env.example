SITE_URL=https://palworld-private.example.com
SITE_TOKEN=replace-with-the-ingest-token
# Must match the site's PLAYER_HASH_SECRET; use PLAYER_HASH_SECRET_FILE when possible.
PLAYER_HASH_SECRET=replace-with-the-site-player-hash-secret
VERIFY_SSL=true
ALLOW_INSECURE_HTTP=false
SAVE_PATH=/opt/Palworld/palworld/Pal/Saved/SaveGames/0/replace-with-world-id/Level.sav
# The adjacent Players/*.sav files are read automatically; *_dps.sav is ignored.
