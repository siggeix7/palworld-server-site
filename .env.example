# Compose/build metadata. APP_BUILD_CONTEXT points to the checked-out source
# directory used by the deployment host.
SITE_PORT=8080
SITE_BIND=127.0.0.1
PRIVATE_PORT=8081
PRIVATE_BIND=127.0.0.1
IMAGE=palworld-server-site:local
APP_BUILD_CONTEXT=./source
APP_PULL_POLICY=build
APP_VERSION=local
VCS_REF=unknown

# Persistent paths. The application data directory must be writable by uid 1000;
# PostgreSQL data must be writable by the postgres container user.
DATA_PATH=./data
APP_SECRETS_PATH=./secrets/app
POSTGRES_DATA_PATH=./postgres-data
POSTGRES_INIT_PATH=./docker/postgres-init.sh
POSTGRES_ENTRYPOINT_PATH=./docker/postgres-entrypoint.sh
POSTGRES_ADMIN_PASSWORD_FILE=./secrets/postgres-admin-password
POSTGRES_APP_PASSWORD_FILE=./secrets/postgres-app-password
POSTGRES_IMAGE=postgres:17-bookworm@sha256:9b18b78397054fce88a9552e9d5a3ad5bb7fd258c5b3cc1c5028e46373d6ea8f
POSTGRES_ADMIN_USER=palworld_admin
POSTGRES_ADMIN_DB=postgres
DB_NAME=palworld_site
DB_USER=palworld_app
DB_CONNECT_TIMEOUT=5
DB_CONN_MAX_AGE=60
# Used only during the one-time SQLite to PostgreSQL migration.
# LEGACY_SQLITE_PATH=/data/palworld-site.sqlite3

# Canonical public origin and Django hosts. PUBLIC_SITE_URL is mandatory and
# must be an absolute HTTPS origin; DJANGO_ALLOWED_HOSTS is a comma-separated list.
PUBLIC_SITE_URL=https://palworld.example.com:8443
DJANGO_ALLOWED_HOSTS=palworld.example.com,localhost,127.0.0.1

# Required secrets. *_FILE, when set, must point to a file readable inside the
# application container and always takes precedence over the direct variable.
# The Compose service mounts APP_SECRETS_PATH at /run/app-secrets; use paths such
# as /run/app-secrets/django-secret-key for file-based application secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_SECRET_KEY_FILE=
PLAYER_HASH_SECRET=replace-with-a-different-long-random-value
PLAYER_HASH_SECRET_FILE=
PRIVATE_API_TOKEN=replace-with-a-long-random-bearer-token
PRIVATE_API_TOKEN_FILE=

# Palworld REST credentials. PALWORLD_API_URL and PALWORLD_API_PASSWORD are
# required by the production entrypoint. HTTP is disabled unless explicitly opted in.
PALWORLD_API_URL=https://palworld.example.com:8212
PALWORLD_API_USER=admin
PALWORLD_API_PASSWORD=replace-with-the-palworld-admin-password
PALWORLD_API_PASSWORD_FILE=
PALWORLD_API_VERIFY_TLS=true
PALWORLD_API_ALLOW_INSECURE_HTTP=false
PALWORLD_API_CONNECT_TIMEOUT=3

# Singleton worker locks and feature flags.
COLLECTOR_LOCK_PATH=/data/palworld-collector.lock
RETENTION_CLEANUP_LOCK_PATH=/data/palworld-retention-cleanup.lock
WEEKLY_REPORT_SCHEDULER_LOCK_PATH=/data/palworld-weekly-scheduler.lock
PLAYER_CLAIMS_ENABLED=false

# Account and save-sync configuration.
SITE_ADMIN_USERS=admin@example.com
CURRENT_TERMS_VERSION=2026-09-14
CURRENT_TERMS_EFFECTIVE_DATE="14 settembre 2026"
PRIVACY_CONTROLLER_NAME=replace-with-real-controller-name
PRIVACY_CONTACT_EMAIL=replace-with-real-contact@example.invalid
AUTH_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1

# Public game-server connection information. The password is returned only by
# the authenticated, private/no-store server-access flow.
PALWORLD_PUBLIC_HOST=palworld.example.com
PALWORLD_PUBLIC_PORT=8211
PALWORLD_PUBLIC_PASSWORD=replace-with-the-game-server-password
PALWORLD_PUBLIC_PASSWORD_FILE=

# SMTP settings. EMAIL_HOST_PASSWORD is optional only when the configured email
# backend does not need authentication.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_HOST_USER=mailer@example.com
EMAIL_HOST_PASSWORD=replace-with-the-mail-account-password
EMAIL_HOST_PASSWORD_FILE=
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=mailer@example.com

# HTTPS hardening. Keep these false/zero for local HTTP development. HSTS must
# only be enabled when every relevant hostname is permanently HTTPS-only.
DJANGO_DEBUG=false
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=86400
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_USE_X_FORWARDED_HOST=false
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true

# Request and data limits/retention. Sizes are bytes; durations are seconds/days.
PRIVATE_API_MAX_BYTES=67108864
DATA_STALE_SECONDS=90
WORLD_DATA_STALE_SECONDS=90
POSITION_RETENTION_DAYS=7
METRIC_RETENTION_DAYS=90
SESSION_RETENTION_DAYS=365
PLAYER_RETENTION_DAYS=365
SAVE_RETENTION_DAYS=30
PLAYER_IP_RETENTION_DAYS=30
TIME_ZONE=Europe/Rome
WEB_WORKERS=2

# Logging verbosity for Django, Gunicorn and worker processes.
LOG_LEVEL=INFO
